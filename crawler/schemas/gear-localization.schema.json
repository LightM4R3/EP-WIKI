{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ep-wiki.local/schemas/gear-localization.schema.json",
  "title": "EP-WIKI localized gear overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "entityType",
    "entityId",
    "locale",
    "source",
    "identity",
    "taxonomy",
    "statLabels",
    "forging",
    "materialLabels",
    "options",
    "sourceAnomalies"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "entityType": { "const": "gear" },
    "entityId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "locale": { "enum": ["ko-KR", "en-US", "ja-JP", "zh-TW"] },
    "source": { "$ref": "#/$defs/source" },
    "identity": { "$ref": "#/$defs/identity" },
    "taxonomy": { "$ref": "#/$defs/taxonomy" },
    "statLabels": {
      "type": "object",
      "required": ["defense"],
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "forging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "suitableAgentLabel", "stageLabels"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "suitableAgentLabel": { "type": "string", "minLength": 1 },
        "stageLabels": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "materialLabels": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/option" },
      "allOf": [
        {
          "contains": {
            "properties": { "slot": { "const": 1 } },
            "required": ["slot"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": { "slot": { "const": 3 } },
            "required": ["slot"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "if": { "minItems": 3 },
          "then": {
            "contains": {
              "properties": { "slot": { "const": 2 } },
              "required": ["slot"]
            },
            "minContains": 1,
            "maxContains": 1
          },
          "else": {
            "not": {
              "contains": {
                "properties": { "slot": { "const": 2 } },
                "required": ["slot"]
              }
            }
          }
        }
      ]
    },
    "sourceAnomalies": {
      "type": "array",
      "items": { "$ref": "#/$defs/anomaly" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "url", "htmlLang", "xmlLang", "observedAt"],
      "properties": {
        "provider": { "const": "wiki.skport.com" },
        "url": { "type": "string", "format": "uri" },
        "htmlLang": { "type": "string", "minLength": 1 },
        "xmlLang": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "introductionBlocks", "acquisitionLabels"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "introductionBlocks": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "acquisitionLabels": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gearTypeId",
        "gearTypeCode",
        "gearTypeLabel",
        "qualityId",
        "qualityCode",
        "qualityLabel",
        "setId",
        "setCode",
        "setLabel"
      ],
      "properties": {
        "gearTypeId": { "type": "integer", "minimum": 0 },
        "gearTypeCode": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "gearTypeLabel": { "type": "string", "minLength": 1 },
        "qualityId": { "type": "integer", "minimum": 0 },
        "qualityCode": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "qualityLabel": { "type": "string", "minLength": 1 },
        "setId": { "type": "integer", "minimum": 0 },
        "setCode": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "setLabel": { "type": "string", "minLength": 1 }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "optionId", "name", "metricLabels"],
      "properties": {
        "slot": { "type": "integer", "minimum": 1, "maximum": 3 },
        "optionId": { "type": "integer", "minimum": 0 },
        "name": { "type": "string", "minLength": 1 },
        "metricLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "anomaly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "sourceText": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
