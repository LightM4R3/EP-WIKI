{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ep-wiki.local/schemas/retrieval-manifest.schema.json",
  "title": "EP-WIKI retrieval ingestion manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetId",
    "releaseId",
    "generatedAt",
    "locale",
    "intendedUse",
    "source",
    "ingestion",
    "quality",
    "stats",
    "documents"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "datasetId": { "const": "epwiki-retrieval" },
    "releaseId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "locale": { "enum": ["ko-KR", "en-US", "ja-JP", "zh-TW"] },
    "intendedUse": { "const": "llm_retrieval" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalizedManifestRef", "normalizedManifestSha256"],
      "properties": {
        "normalizedManifestRef": { "type": "string", "minLength": 1 },
        "normalizedManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "ingestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestIsSoleEntryPoint",
        "documentsRoot",
        "namespace",
        "mode",
        "deleteMissing",
        "forbiddenRoots"
      ],
      "properties": {
        "manifestIsSoleEntryPoint": { "const": true },
        "documentsRoot": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 },
        "mode": { "const": "synchronize" },
        "deleteMissing": { "const": true },
        "forbiddenRoots": {
          "type": "array",
          "contains": { "const": "data/rag/normalized" },
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["indexable", "coverageComplete", "refreshStatus", "qualityReportRef"],
      "properties": {
        "indexable": { "type": "boolean" },
        "coverageComplete": { "type": "boolean" },
        "refreshStatus": { "type": "string", "minLength": 1 },
        "qualityReportRef": { "type": "string", "minLength": 1 }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documents", "byDocumentType"],
      "properties": {
        "documents": { "type": "integer", "minimum": 1 },
        "byDocumentType": { "type": "object" }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentId",
          "semanticKey",
          "documentType",
          "entity",
          "ref",
          "contentSha256",
          "payloadSha256"
        ],
        "properties": {
          "documentId": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
          "semanticKey": { "type": "string", "minLength": 5 },
          "documentType": { "type": "string", "minLength": 1 },
          "entity": { "type": "object" },
          "ref": { "type": "string", "minLength": 1 },
          "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "payloadSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
