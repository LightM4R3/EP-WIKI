    {
      "id": "tangtang.ultimate",
      "order": 3,
      "typeId": 3,
      "typeCode": "ultimate",
      "name": "DA CHIEF SEES YOU!",
      "sourceType": "Ultimate",
      "descriptionBlocks": [
